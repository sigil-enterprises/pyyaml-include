# Normalize line endings to LF in the repo, regardless of OS-level git config.
# Prevents diff noise from Windows checkouts.
* text=auto eol=lf

# Binary types — never normalize.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
