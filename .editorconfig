# Watermarked by tc from github.com/sigil-enterprises/toolchain@v0.39.2
#
# EditorConfig — minimal cross-editor whitespace defaults.
# Language-specific style is enforced by linters (ruff, prettier, rustfmt),
# not here.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py}]
indent_size = 4

[Makefile]
indent_style = tab
