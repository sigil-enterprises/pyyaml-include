# Watermarked by tc from github.com/sigil-enterprises/sigil-toolchain@v0.39.2
#
# ─────────────────────────────────────────────
# python layer .gitignore — pinned by toolchain
#
# This file is overwritten on every `tc update`. For project-local ignores
# that should NOT be committed, use .git/info/exclude (git-native, untracked).
# Supersedes base/.gitignore — must keep universal entries so the
# ignore-gitignore-secrets / ignore-gitignore-os checks still pass.
# Must NOT exclude .toolchain/ or .toolkit/ (toolchain-not-gitignored check).

# Secrets / environments
.env
.env.*
.venv
.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json

# Logs
logs
*.log
nohup.out
pip-log.txt

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# setuptools-scm generated version file
src/*/_version.py

# Distribution / packaging
.Python
builds/
build/
reports/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Linter caches
.ruff_cache/
.mypy_cache/

# Docs
docs/_build/
